{
  "name": "@opencoachingformat/validator",
  "version": "0.2.0",
  "description": "Reference validator for the Open Coaching Format",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opencoachingformat/ocf-validator.git",
    "directory": "packages/ts"
  },
  "homepage": "https://opencoachingformat.org",
  "bugs": {
    "url": "https://github.com/opencoachingformat/ocf-validator/issues"
  },
  "license": "CC-BY-4.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ocf-validate": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && npm run build:browser",
    "build:browser": "tsup --config tsup.browser.config.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
